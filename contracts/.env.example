# Copy to .env and fill in. .env is gitignored.

# Required to deploy: deployer EOA's private key (no 0x prefix or with —
# Hardhat handles both). Fund it with Amoy MATIC from
# https://faucet.polygon.technology before running `npm run deploy:amoy`.
DEPLOYER_PRIVATE_KEY=

# Polygon Amoy public RPC. Override if you have a private node.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Required for `npm run verify:amoy`. Get a free key from
# https://amoyscan.com (or https://polygonscan.com → API tab).
POLYGONSCAN_API_KEY=

# Optional: enable gas report on `hardhat test`.
REPORT_GAS=false

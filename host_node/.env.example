HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
# Laptop ASGI/UI demos may use DEMO_MODE=true (synthetic meter ticks).
# Raspberry Pi Iteration 2 MUST use DEMO_MODE=false (nf_conntrack metering).
DEMO_MODE=false
SESSION_DEFAULT_TTL_SECONDS=3600
METER_TICK_SECONDS=2.0
ALLOWED_ORIGINS=["*"]

# Iteration 2 Pi: ALLOW_CLIENT_MAC=false so MAC always comes from ARP.
# Set true only for laptop/ASGI tests without a neighbour table.
ALLOW_CLIENT_MAC=false
HOST_DISPLAY_NAME=STRATA Host
HOST_SSID=STRATA-Pi-01
DEFAULT_PRICE_PER_GB_WEI=1000000000000000
DEFAULT_PRICE_PER_GB=0.5

# --- Iteration 3: on-chain SessionEscrow ---
# Payment model: lock funds → active session → usage-based settlement → closeSession.
# NOT an L2 streaming channel.
#
# Fail-fast: CHAIN_ENABLED=true WITHOUT the addresses/key below will refuse to boot.
# Iteration 2 demos keep CHAIN_ENABLED=false (admit on verified EIP-191 session start).
CHAIN_ENABLED=false
# Iteration 3 RPC — WebSocket (Amoy) OR HTTP (Hardhat localhost).
# Examples:
#   CHAIN_RPC_URL=wss://polygon-amoy-bor-rpc.publicnode.com
#   CHAIN_RPC_URL=http://127.0.0.1:8545
# Legacy alias (used when CHAIN_RPC_URL is empty):
AMOY_WSS_URL=wss://polygon-amoy-bor-rpc.publicnode.com
CHAIN_RPC_URL=
SESSION_ESCROW_ADDRESS=
STRATA_TOKEN_ADDRESS=
HOST_WALLET_ADDRESS=
# Same EOA as HOST_WALLET_ADDRESS — hex key for EIP-191 settlement signatures.
# NEVER commit a real key. Generate with: python -c "from eth_account import Account; a=Account.create(); print(a.address, a.key.hex())"
HOST_SIGNING_PRIVATE_KEY=
CHAIN_ID=80002
# Blocks to wait before admitting after SessionOpened (DEMO_MODE forces 0).
CHAIN_CONFIRMATIONS=3

# --- Iteration 3: periodic micropayment (router side) ---
# Sign a usage checkpoint for every active on-chain session this often.
SETTLEMENT_CHECKPOINT_SECONDS=60
# After a session stops the guest has SETTLE_GRACE_SECONDS to closeSession
# from the app; after that the host node submits it itself. The host wallet
# (HOST_WALLET_ADDRESS) needs native gas (POL on Amoy) for this.
HOST_AUTO_SETTLE=true
SETTLE_GRACE_SECONDS=120
SETTLE_POLL_SECONDS=15
SETTLE_MAX_ATTEMPTS=8
# Stop sessions older than this so they settle before the guest can dispute (24 h).
SESSION_MAX_AGE_SECONDS=82800

# --- Phase F: firewall + WireGuard egress ---
# Names of the interfaces the nftables ruleset binds to. wlan0 = AP that
# guests join, eth0 = uplink to the modem/ISP. Override on hardware where
# this is wrong (e.g. eth1 on a Pi 5 with a USB NIC).
#
# Iteration 1 AP bring-up lives in host_node/ap/ (hostapd + dnsmasq).
# Keep GUEST_IFACE == AP_IFACE and WAN_IFACE == ap/.env WAN_IFACE.
# Guest subnet is 192.168.50.0/24 with gateway 192.168.50.1 — see ap/README.md.
GUEST_IFACE=wlan0
WAN_IFACE=eth0
PORTAL_PORT=8080
SSH_PORT=22

# WireGuard exit-tunnel. WG_ENABLED=true WITHOUT peer pubkey/endpoint refuses to boot.
# Rollback: set WG_ENABLED=false and restart host_node — nftables postrouting
# returns to normal WAN masquerade (residential IP egress).
WG_ENABLED=false
WG_PRIVATE_KEY_PATH=/etc/strata/wg0.key
WG_LISTEN_PORT=51820
WG_PEER_PUBLIC_KEY=
WG_PEER_ENDPOINT=
WG_PEER_ALLOWED_IPS=0.0.0.0/0,::/0
WG_ADDRESS=10.66.66.1/24
# Only traffic FROM GUEST_SUBNET goes through wg0 (policy routing table
# WG_ROUTE_TABLE); the Pi's own traffic stays on WAN_IFACE.
GUEST_SUBNET=192.168.50.0/24
WG_ROUTE_TABLE=51820
WG_RULE_PRIORITY=10000
# false = kill switch: tunnel down -> guests blocked (never leak via WAN).
# true  = tunnel down -> guests fall back to the residential WAN.
WG_FALLBACK_TO_WAN=false
WG_ROUTE_CHECK_SECONDS=15

# --- Phase G: integration pass ---
# ADMIN_TOKEN gates /admin/reconcile and /admin/firewall/state.
# Flutter My Hosting can optionally mirror live admitted MACs with:
#   --dart-define=STRATA_ADMIN_TOKEN=<same value>
# Leave unset to disable admin routes (My Hosting still works via /host/sessions).
ADMIN_TOKEN=
# CHAIN_CONFIRMATIONS also documented under Iteration 3 block above.
# Chatroom — SQLite persistence, otherwise RAM-only (loses history on restart).
# Works on guest LAN with WAN disconnected (SOS emergency room).
CHATROOM_PERSIST=false
CHATROOM_DB_PATH=/var/lib/strata/chatroom.sqlite
CHATROOM_HISTORY_LIMIT=500
CHATROOM_HISTORY_TTL_HOURS=24
# mDNS advertiser ("_strata._tcp.local.") so the Flutter app can find this Pi
# on the LAN without a hardcoded URL.
MDNS_ENABLED=true

# Optional SQLite persistence for the in-memory session store (Pi reboot).
PERSIST_SESSIONS=false
SESSION_DB_PATH=/var/lib/strata/sessions.db

# STRATA Raspberry Pi AP — local configuration
# Copy to host_node/ap/.env and edit. Never commit .env.
#
#   cp host_node/ap/env.example host_node/ap/.env
#
# Values here must stay aligned with host_node GUEST_IFACE / Flutter's
# default HOST_API_URL (http://192.168.50.1:8080). See ap/README.md.

# --- Interfaces (must match host_node/.env GUEST_IFACE / WAN_IFACE) ---
AP_IFACE=wlan0
WAN_IFACE=eth0

# --- Wi-Fi ---
# SSID should keep the STRATA- prefix so guests can recognise the network.
SSID=STRATA-Pi-01
# WPA2 passphrase: 8–63 characters. Change before any real deployment.
# setup_ap.sh refuses to start if this is still the placeholder below.
WPA_PASSPHRASE=CHANGE_ME_DEV_ONLY
# ISO country code required by the regulatory domain (e.g. PK, US, GB).
COUNTRY_CODE=PK
# 2.4 GHz: hw_mode=g, channel 1–11 (avoid DFS). 5 GHz needs hw_mode=a + capable NIC.
HW_MODE=g
CHANNEL=6

# --- Guest subnet (matches firewall integration tests + Flutter default) ---
# Pi AP address / gateway that clients will use to reach host_node (:8080).
AP_ADDRESS=192.168.50.1
AP_PREFIX=24
DHCP_RANGE_START=192.168.50.50
DHCP_RANGE_END=192.168.50.200
DHCP_LEASE=12h
# Upstream resolvers used by dnsmasq (guest DNS → Pi → these).
UPSTREAM_DNS_1=1.1.1.1
UPSTREAM_DNS_2=8.8.8.8

# --- Runtime paths (defaults are fine on Raspberry Pi OS) ---
# Generated configs are written here (not committed).
GENERATED_DIR=/etc/strata/ap
# Optional lab-only IPv4 NAT via iptables so clients can reach the internet
# *before* host_node's nftables ruleset is applied. Leave false for a clean
# Iteration 1 AP (clients get DHCP + can ping the Pi). When host_node applies
# the strata nftables ruleset later, prefer that path and keep this false.
ENABLE_LAB_NAT=false
